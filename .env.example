# Vibe Forge environment configuration.
# Copy to `.env` and fill in the required values:  `cp .env.example .env`
# Docker Compose auto-loads `.env` for variable substitution in compose.yaml.

# ---- Required for the product to function (agent loop) ----------------------
# Anthropic API key for the single agent loop (PM -> Architect -> Engineer -> QA).
# Without it the backend starts but /api/health reports model "not_configured"
# (503) and run creation is rejected. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# ---- Optional ---------------------------------------------------------------
# Model used by the agent loop. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Backend HTTP port (host). Defaults to 8787 to avoid clashing with OrbStack's
# host port 8080 proxy.
BACKEND_PORT=8787

# Frontend HTTP port (host). Defaults to 5173.
FRONTEND_PORT=5173

# SQLite database path inside the backend container. The compose file mounts the
# `vibe-forge-db` volume here. NOTE: `docker compose down -v` deletes this
# volume and all project data.
DATABASE_PATH=/data/vibe-forge.db
