# Vibe Forge environment configuration.
# Copy to `.env` and fill in the required values:  `cp .env.example .env`
# Docker Compose auto-loads `.env` for variable substitution in compose.yaml.

# ---- Required for the site access gate --------------------------------------
# These values are consumed only by the Go backend. Never use a VITE_ prefix.
# Replace both placeholders in the untracked `.env`; the session secret must be
# at least 32 bytes and must differ from the access password.
APP_ACCESS_PASSWORD=change-me
APP_AUTH_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Local Compose runs over HTTP. Production defaults to secure cookies and
# should set APP_ENV=production explicitly.
APP_ENV=development

# Optional access-session lifetime. Defaults to 12 hours; valid range is 1–24.
APP_AUTH_SESSION_TTL_HOURS=12

# Forwarded client-address headers are ignored unless the direct peer is in this
# explicit CIDR allowlist. Compose defaults to its fixed nginx address; external
# deployments should set only exact reverse-proxy /32 (IPv4) or /128 (IPv6)
# peers. Never allow an entire private network.
# APP_AUTH_TRUSTED_PROXY_CIDRS=172.31.247.10/32

# ---- Required for the product to function (agent loop) ----------------------
# The agent loop (PM -> Architect -> Engineer -> QA) needs model credentials.
# Pick ONE of the two auth modes:
#
#   Mode A - direct API key (default):
#       ANTHROPIC_API_KEY=<sk-...>
#
#   Mode B - bearer-token gateway (Anthropic-compatible platform proxy):
#       ANTHROPIC_AUTH_TOKEN=<token>
#       ANTHROPIC_BASE_URL=https://your-gateway.example.com/api
#
# Without either, the backend starts but /api/health reports model
# "not_configured" (503) and run creation is rejected. Get a direct key at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=

# ---- Optional model/runtime settings ----------------------------------------
# Model used by the agent loop. Defaults to claude-sonnet-5. Set this to the
# model name your gateway expects when using Mode B (e.g. glm-5.2).
ANTHROPIC_MODEL=claude-sonnet-5

# Backend HTTP port (host loopback only). Defaults to 8787 to avoid clashing
# with OrbStack's host port 8080 proxy.
BACKEND_PORT=8787

# Frontend HTTP port (host). Defaults to 5173.
FRONTEND_PORT=5173

# Revision embedded in the frontend build manifest. Local builds default to
# "local"; production deploys must supply the full Git SHA.
BUILD_REVISION=local

# SQLite database path inside the backend container. The compose file mounts the
# `vibe-forge-db` volume here. NOTE: `docker compose down -v` deletes this
# volume and all project data.
DATABASE_PATH=/data/vibe-forge.db
